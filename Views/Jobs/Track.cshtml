@model Career635.Features.Jobs.Models.TrackViewModel
@{
    ViewData["Title"] = "Application Tracking | Career 635";
    
    // Helper for secure image/file access
    string GetUrl(string? path) => string.IsNullOrEmpty(path) 
        ? "" 
        : Url.Action("GetFile", "Jobs", new { path = path }) ?? "";
}

@section Styles {
    <style>
        /* --- WEB UI STYLES --- */
        .status-pill { padding: 0.4rem 0.8rem; border-radius: 6px; font-size: 0.7rem; font-weight: 800; text-transform: uppercase; letter-spacing: 0.025em; border: 1px solid transparent; }
        .status-pending { background: #fffbeb; color: #92400e; border-color: #fef3c7; }
        .status-shortlisted { background: #f0fdf4; color: #166534; border-color: #dcfce7; }
        .status-rejected { background: #fef2f2; color: #991b1b; border-color: #fee2e2; }

        .card-shadow { box-shadow: 0 4px 6px -1px rgba(0, 0, 0, 0.05), 0 2px 4px -1px rgba(0, 0, 0, 0.03); }
        .info-label { font-size: 0.65rem; color: #94a3b8; font-weight: 700; text-transform: uppercase; margin-bottom: 2px; }
        .info-value { font-size: 0.85rem; color: #334155; font-weight: 600; }

        /* --- PRINT SYSTEM --- */
        @@media print {
            body { background: white !important; margin: 0; padding: 0; font-family: 'Times New Roman', Times, serif; color: black; }
            .no-print { display: none !important; }
            
            .print-container { 
                display: block !important; 
                padding: 15mm;
                width: 100%;
                line-height: 1.3;
            }

            .print-header { 
                border-bottom: 2px solid #000; 
                padding-bottom: 10px; 
                margin-bottom: 20px; 
                display: flex; 
                justify-content: space-between; 
                align-items: center; 
            }

            .print-logo { height: 50px; }
            .print-title { font-size: 18pt; font-weight: bold; text-transform: uppercase; }

            .section-title { 
                background: #f1f5f9 !important; 
                padding: 5px 10px; 
                font-weight: bold; 
                border: 1px solid #000; 
                margin-top: 15px; 
                text-transform: uppercase;
                font-size: 10pt;
                -webkit-print-color-adjust: exact;
            }

            table { width: 100%; border-collapse: collapse; margin-top: 5px; }
            th, td { border: 1px solid #000; padding: 8px; text-align: left; font-size: 9pt; vertical-align: top; }
            
            .photo-box { 
                width: 35mm; 
                height: 45mm; 
                border: 1px solid #000; 
                display: flex; 
                align-items: center; 
                justify-content: center; 
                text-align: center;
                font-size: 8pt;
            }

            .footer-note { margin-top: 30px; font-size: 9pt; border-top: 1px solid #000; padding-top: 10px; }
        }
    </style>
}

@functions {
    public string Val(object? val) {
        if (val == null) return "—";
        string s = val.ToString()?.Trim() ?? "";
        if (string.IsNullOrEmpty(s) || s == "0" || s == "0.00" || s.Contains("0001-01-01")) return "—";
        return s;
    }
}

<div class="container mx-auto px-6 py-12 max-w-5xl no-print">
    
    <!-- SEARCH SECTION -->
    <div class="text-center mb-10">
        <img src="/career635.png" alt="Career 635" class="h-14 mx-auto mb-4" />
        <h1 class="text-3xl font-black text-slate-800 tracking-tight">Application Tracker</h1>
        <p class="text-slate-500 font-medium">Verify your application status and retrieve your submission records.</p>
    </div>

    <div class="max-w-2xl mx-auto mb-16">
        <form method="get" class="bg-white p-1.5 rounded-2xl shadow-2xl border border-slate-100 flex flex-col md:flex-row gap-2">
            <div class="flex-1 flex items-center px-4 gap-3 py-2">
                <i data-lucide="search" class="w-5 h-5 text-slate-400"></i>
                <input name="code" value="@Model.SearchValue" type="text" 
                       placeholder="Tracking ID or CNIC Number" 
                       class="w-full bg-transparent outline-none font-bold text-slate-700 placeholder:font-normal" required />
            </div>
            <button type="submit" class="bg-slate-900 text-white px-8 py-3.5 rounded-xl font-bold hover:bg-blue-700 transition-all flex items-center justify-center gap-2">
                Find My Application
            </button>
        </form>
    </div>

    @if (Model.Searched && Model.Result != null)
    {
        <div class="space-y-6">
            @foreach (var app in Model.Result.Applications)
            {
                <!-- PROFESSIONAL CARD -->
                <div class="bg-white rounded-2xl border-l-4 border-l-slate-900 border border-slate-200 card-shadow overflow-hidden transition-all hover:border-blue-200">
                    <div class="p-6 md:p-8">
                        <div class="flex flex-col lg:flex-row lg:items-center justify-between gap-6">
                            
                            <div class="flex-1">
                                <div class="flex items-center gap-3 mb-3">
                                    <span class="text-[10px] font-bold text-slate-400 font-mono tracking-widest">REF# @app.TrackingCode</span>
                                    <span class="status-pill status-@app.Status.ToLower()">@app.Status</span>
                                </div>
                                
                                <h2 class="text-xl font-black text-slate-900 mb-6">@app.JobTitle</h2>
                                
                                <div class="grid grid-cols-2 md:grid-cols-3 gap-6">
                                    <div>
                                        <p class="info-label">Submission Date</p>
                                        <p class="info-value local-time" data-utc="@app.AppliedAt.ToString("o")">...</p>
                                    </div>
                                    <div>
                                        <p class="info-label">Vacancy Posted</p>
                                        <p class="info-value local-time" data-utc="@app.PublishedDate.ToString("o")">...</p>
                                    </div>
                                    <div class="hidden md:block">
                                        <p class="info-label">Vacancy Closing</p>
                                        <p class="info-value local-time" data-utc="@app.ExpiredDate.ToString("o")">...</p>
                                    </div>
                                </div>
                            </div>

                            <div class="lg:w-48 flex flex-col gap-3">
                                @if (!app.IsExpired)
                                {
                                    <button onclick="printApplication('@app.ApplicationId')" class="w-full bg-white border-2 border-slate-900 text-slate-900 px-4 py-2.5 rounded-lg font-bold text-xs hover:bg-slate-900 hover:text-white transition-all flex items-center justify-center gap-2">
                                        <i data-lucide="download" class="w-4 h-4"></i> Print Application
                                    </button>
                                }
                                else
                                {
                                    <span class="text-center py-2 px-4 bg-slate-50 text-slate-400 text-[10px] font-black uppercase rounded-lg border border-dashed border-slate-200">
                                        Process Closed
                                    </span>
                                }
                            </div>
                        </div>
                    </div>
                </div>

                <!-- HIDDEN PRINTABLE FORM -->
                <div id="print-source-@app.ApplicationId" class="hidden">
                    <div class="print-container">
                        <div class="print-header">
                            <img src="/career635.png" class="print-logo" />
                            <div class="print-title">Application for Employment</div>
                            <div class="photo-box">
                                @if (!string.IsNullOrEmpty(app.Dossier.PhotoUrl)) {
                                    <img src="@GetUrl(app.Dossier.PhotoUrl)" style="width:100%; height:100%; object-fit:cover;" />
                                } else { <span>Affix Passport<br/>Photo Here</span> }
                            </div>
                        </div>

                        <div style="margin-bottom: 20px;">
                            <p style="font-size: 14pt; margin: 0;"><strong>Job Title: @app.JobTitle</strong></p>
                            <p style="font-size: 10pt; color: #444; margin-top: 5px;">Tracking Reference: @app.TrackingCode</p>
                        </div>

                        <div class="section-title">Personal Details</div>
                        <table>
                            <tr>
                                <td width="25%"><strong>Full Name</strong></td><td width="25%">@Val(app.Dossier.FullName)</td>
                                <td width="25%"><strong>CNIC Number</strong></td><td width="25%">@Val(app.Dossier.CNIC)</td>
                            </tr>
                            <tr>
                                <td><strong>Father's Name</strong></td><td>@Val(app.Dossier.Personal.FatherName)</td>
                                <td><strong>Date of Birth</strong></td><td class="local-time-print">@app.Dossier.Personal.DOB.ToString("o")</td>
                            </tr>
                            <tr>
                                <td><strong>Contact Number</strong></td><td>@Val(app.Dossier.Personal.ContactNo)</td>
                                <td><strong>Email Address</strong></td><td>@Val(app.Dossier.Personal.Email)</td>
                            </tr>
                            <tr>
                                <td colspan="4"><strong>Postal Address:</strong> @Val(app.Dossier.Personal.PresentAddress)</td>
                            </tr>
                        </table>

                        <div class="section-title">Application Timeline</div>
                        <table>
                            <tr>
                                <th>Job Posting Date</th>
                                <th>Submission Date</th>
                                <th>Closing Date</th>
                            </tr>
                            <tr>
                                <td class="local-time-print">@app.PublishedDate.ToString("o")</td>
                                <td class="local-time-print">@app.AppliedAt.ToString("o")</td>
                                <td class="local-time-print">@app.ExpiredDate.ToString("o")</td>
                            </tr>
                        </table>

                        <div class="section-title">Educational Qualifications</div>
                        <table>
                            <thead>
                                <tr>
                                    <th>Degree</th>
                                    <th>Major</th>
                                    <th>Institute</th>
                                    <th>Marks/GPA</th>
                                </tr>
                            </thead>
                            <tbody>
                                @foreach (var edu in app.Dossier.Educations) {
                                    <tr>
                                        <td>@edu.Qualification</td>
                                        <td>@edu.Major</td>
                                        <td>@edu.Institute</td>
                                        <td>@edu.Result</td>
                                    </tr>
                                }
                            </tbody>
                        </table>

                        <div class="footer-note">
                            <p><strong>Declaration:</strong> I certify that all information provided is true and accurate. I understand that any false statement may result in the disqualification of my application.</p>
                            
                            <div style="display:flex; justify-content:space-between; margin-top:50px;">
                                <div style="border-top: 1px solid #000; width: 180px; text-align: center; padding-top: 5px;">Date</div>
                                <div style="border-top: 1px solid #000; width: 220px; text-align: center; padding-top: 5px;">Applicant Signature</div>
                            </div>
                            
                            <p style="text-align: right; margin-top: 30px; font-size: 8pt; color: #777; font-family: monospace;">
                                Verified System Record - Generated on <span class="local-time-print">@DateTime.UtcNow.ToString("o")</span>
                            </p>
                        </div>
                    </div>
                </div>
            }

            <!-- PAGINATION -->
            @if (Model.Result.TotalPages > 1)
            {
                <div class="flex justify-center items-center gap-2 mt-12 py-6">
                    @for (int i = 1; i <= Model.Result.TotalPages; i++)
                    {
                        <a href="?code=@Model.SearchValue&pageNumber=@i" 
                           class="w-10 h-10 flex items-center justify-center rounded-lg font-bold text-sm transition-all @(i == Model.Result.CurrentPage ? "bg-slate-900 text-white shadow-lg" : "bg-white border border-slate-200 text-slate-500 hover:border-slate-900 hover:text-slate-900")">
                            @i
                        </a>
                    }
                </div>
            }
        </div>
    }
    else if (Model.Searched)
    {
        <div class="bg-white rounded-3xl border border-slate-200 p-16 text-center shadow-sm">
            <div class="w-16 h-16 bg-slate-50 rounded-full flex items-center justify-center mx-auto mb-4">
                <i data-lucide="user-x" class="w-8 h-8 text-slate-300"></i>
            </div>
            <h3 class="text-xl font-bold text-slate-900">No Applications Found</h3>
            <p class="text-slate-500 mt-2 max-w-xs mx-auto">We couldn't find any records matching the details provided.</p>
            <a href="@Url.Action("Track")" class="mt-6 inline-block text-blue-600 font-bold text-sm underline underline-offset-4">Reset Search</a>
        </div>
    }
</div>

@section Scripts {
    <script>
        function formatLocalTime(isoString) {
            if (!isoString || isoString.includes("0001-01-01")) return "—";
            const date = new Date(isoString);
            if (isNaN(date.getTime())) return isoString;

            return new Intl.DateTimeFormat('en-GB', { 
                day: '2-digit', 
                month: 'short', 
                year: 'numeric',
                hour: '2-digit', 
                minute: '2-digit',
                hour12: true 
            }).format(date);
        }

        document.addEventListener("DOMContentLoaded", function() {
            // Update web view timestamps
            document.querySelectorAll('.local-time').forEach(el => {
                el.innerText = formatLocalTime(el.getAttribute('data-utc'));
            });

            if (typeof lucide !== 'undefined') lucide.createIcons();
        });

        function printApplication(id) {
            const printElement = document.getElementById('print-source-' + id);
            
            // Format timestamps for the printed document
            printElement.querySelectorAll('.local-time-print').forEach(el => {
                el.innerText = formatLocalTime(el.innerText.trim());
            });

            const content = printElement.innerHTML;
            const originalBody = document.body.innerHTML;

            document.body.innerHTML = content;
            window.print();

            // Refresh to restore UI
            window.location.reload();
        }
    </script>
}