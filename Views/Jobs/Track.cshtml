@model Career635.Features.Jobs.Models.TrackViewModel
@{
    ViewData["Title"] = "Track Your Application | Career 635";
    
    // Helper for secure image/file access
    string GetUrl(string? path) => string.IsNullOrEmpty(path) 
        ? "" 
        : Url.Action("GetFile", "Jobs", new { path = path }) ?? "";
}

@section Styles {
    <style>
        /* --- WEB UI STYLES --- */
        .status-pill { padding: 0.4rem 1rem; border-radius: 99px; font-size: 0.75rem; font-weight: 700; text-transform: uppercase; border: 1px solid transparent; }
        .status-pending { background: #fffbeb; color: #92400e; border-color: #fef3c7; }
        .status-shortlisted { background: #f0fdf4; color: #166534; border-color: #dcfce7; }
        .status-rejected { background: #fef2f2; color: #991b1b; border-color: #fee2e2; }

        .info-label { font-size: 0.7rem; color: #64748b; font-weight: 600; text-transform: uppercase; margin-bottom: 2px; }
        .info-value { font-size: 0.9rem; color: #1e293b; font-weight: 600; }

        /* --- PRINT SYSTEM --- */
        #print-content { display: none; }

        @@media print {
            body { background: white !important; margin: 0; padding: 0; font-family: 'Segoe UI', Tahoma, Geneva, Verdana, sans-serif; color: black; }
            .no-print { display: none !important; }
            
            .print-container { 
                display: block !important; 
                padding: 20px;
                width: 100%;
                line-height: 1.4;
            }

            .print-header { 
                border-bottom: 2px solid #333; 
                padding-bottom: 15px; 
                margin-bottom: 20px; 
                display: flex; 
                justify-content: space-between; 
                align-items: center; 
            }

            .print-logo { height: 60px; }
            .print-title { font-size: 22px; font-weight: bold; text-transform: uppercase; }

            .section-title { 
                background: #f8fafc !important; 
                padding: 8px 12px; 
                font-weight: bold; 
                border: 1px solid #e2e8f0; 
                margin-top: 20px; 
                text-transform: uppercase;
                font-size: 14px;
                -webkit-print-color-adjust: exact;
            }

            table { width: 100%; border-collapse: collapse; margin-top: 10px; }
            th, td { border: 1px solid #cbd5e1; padding: 10px; text-align: left; font-size: 12px; vertical-align: top; }
            th { background-color: #f1f5f9 !important; -webkit-print-color-adjust: exact; }

            .photo-box { 
                width: 120px; 
                height: 150px; 
                border: 1px solid #333; 
                display: flex; 
                align-items: center; 
                justify-content: center; 
                text-align: center;
                font-size: 10px;
            }

            .footer-note { margin-top: 40px; font-size: 11px; border-top: 1px solid #eee; padding-top: 10px; }
        }
    </style>
}

@functions {
    // Clean display for empty data
    public string Val(object? val) {
        if (val == null) return "—";
        string s = val.ToString()?.Trim() ?? "";
        if (string.IsNullOrEmpty(s) || s == "0" || s == "0.00" || s.Contains("0001-01-01")) return "—";
        return s;
    }
}

<div class="container mx-auto px-6 py-12 max-w-5xl no-print">
    
    <!-- HEADER -->
    <div class="text-center mb-12">
        <img src="/career635.png" alt="Career 635" class="h-16 mx-auto mb-6" />
        <h1 class="text-3xl font-extrabold text-slate-900">Application Tracking System</h1>
        <p class="text-slate-500 mt-2">Enter your details below to check your job application status.</p>
    </div>

    <!-- SEARCH FORM -->
    <div class="max-w-3xl mx-auto mb-12">
        <form method="get" class="bg-white p-2 rounded-2xl shadow-xl border border-slate-200 flex flex-col md:flex-row gap-2">
            <div class="flex-1 flex items-center px-4 gap-3 py-2">
                <i data-lucide="search" class="w-5 h-5 text-slate-400"></i>
                <input name="code" value="@Model.SearchValue" type="text" 
                       placeholder="Enter Tracking ID (e.g. 635-XXX) or CNIC Number" 
                       class="w-full bg-transparent outline-none font-semibold text-slate-700" required />
            </div>
            <button type="submit" class="bg-blue-600 text-white px-8 py-3 rounded-xl font-bold hover:bg-blue-700 transition-all">
                Search Application
            </button>
        </form>
    </div>

    @if (Model.Searched && Model.Result != null)
    {
        <div class="space-y-6">
            @foreach (var app in Model.Result.Applications)
            {
                <div class="bg-white rounded-3xl border border-slate-200 p-8 shadow-sm overflow-hidden">
                    <div class="flex flex-col lg:flex-row justify-between gap-8">
                        
                        <div class="flex-1">
                            <div class="flex items-center gap-3 mb-4">
                                <span class="bg-slate-100 text-slate-600 px-3 py-1 rounded-md text-xs font-mono font-bold">ID: @app.TrackingCode</span>
                                <span class="status-pill status-@app.Status.ToLower()">@app.Status</span>
                            </div>
                            
                            <h2 class="text-2xl font-bold text-slate-900 mb-6">@app.JobTitle</h2>
                            
                            <!-- TIMELINE -->
                            <div class="grid grid-cols-1 md:grid-cols-3 gap-6">
                                <div>
                                    <p class="info-label">Posted On</p>
                                    <p class="info-value local-time" data-utc="@app.PublishedDate.ToString("o")">...</p>
                                </div>
                                <div>
                                    <p class="info-label">Applied On</p>
                                    <p class="info-value local-time" data-utc="@app.AppliedAt.ToString("o")">...</p>
                                </div>
                                <div>
                                    <p class="info-label">Closing Date</p>
                                    <p class="info-value local-time" data-utc="@app.ExpiredDate.ToString("o")">...</p>
                                </div>
                            </div>
                        </div>

                        <div class="flex flex-col justify-center items-end border-l border-slate-100 pl-8 min-w-[200px]">
                            @if (!app.IsExpired)
                            {
                                <button onclick="printApplication('@app.ApplicationId')" class="w-full bg-slate-900 text-white px-6 py-3 rounded-xl font-bold text-sm hover:bg-blue-600 transition-all flex items-center justify-center gap-2">
                                    <i data-lucide="printer" class="w-4 h-4"></i> Print Form
                                </button>
                            }
                            else
                            {
                                <div class="w-full text-center p-3 bg-slate-50 rounded-xl text-slate-400 text-[10px] font-bold uppercase border border-slate-100">
                                    Job Closed
                                </div>
                            }
                        </div>
                    </div>
                </div>

                <!-- HIDDEN PRINTABLE FORM -->
                <div id="print-source-@app.ApplicationId" class="hidden">
                    <div class="print-container">
                        <!-- Header -->
                        <div class="print-header">
                            <img src="/career635.png" class="print-logo" />
                            <div class="print-title"> Candidate Application </div>
                            <div class="photo-box">
                                @if (!string.IsNullOrEmpty(app.Dossier.PhotoUrl)) {
                                    <img src="@GetUrl(app.Dossier.PhotoUrl)" style="width:100%; height:100%; object-fit:cover;" />
                                } else { <span>Paste Recent Photo</span> }
                            </div>
                        </div>

                        <div style="margin-bottom: 20px;">
                            <p>This is to confirm that <strong>@app.Dossier.FullName</strong> has applied for the position of <strong>@app.JobTitle</strong> at Career 635.</p>
                            <p style="font-size: 11px; color: #666;">Tracking ID: @app.TrackingCode 
                                @* | Status: @app.Status *@
                                </p>
                        </div>

                        <!-- Personal Info -->
                        <div class="section-title">Personal Information</div>
                        <table>
                            <tr>
                                <td width="25%"><strong>Full Name</strong></td><td width="25%">@Val(app.Dossier.FullName)</td>
                                <td width="25%"><strong>CNIC Number</strong></td><td width="25%">@Val(app.Dossier.CNIC)</td>
                            </tr>
                            <tr>
                                <td><strong>Father's Name</strong></td><td>@Val(app.Dossier.Personal.FatherName)</td>
                                <td><strong>Date of Birth</strong></td><td class="local-time-print">@app.Dossier.Personal.DOB.ToString("o")</td>
                            </tr>
                            <tr>
                                <td><strong>Contact Number</strong></td><td>@Val(app.Dossier.Personal.ContactNo)</td>
                                <td><strong>Email Address</strong></td><td>@Val(app.Dossier.Personal.Email)</td>
                            </tr>
                            <tr>
                                <td colspan="4"><strong>Current Address:</strong> @Val(app.Dossier.Personal.PresentAddress)</td>
                            </tr>
                        </table>

                        <!-- Important Dates -->
                        <div class="section-title">Application Timeline</div>
                        <table>
                            <tr>
                                <th>Job Posted On</th>
                                <th>Application Submitted</th>
                                <th>Job Closing Date</th>
                            </tr>
                            <tr>
                                <td class="local-time-print">@app.PublishedDate.ToString("o")</td>
                                <td class="local-time-print">@app.AppliedAt.ToString("o")</td>
                                <td class="local-time-print">@app.ExpiredDate.ToString("o")</td>
                            </tr>
                        </table>

                 

                     
                        <div class="footer-note">
                            <p><strong>Declaration:</strong> I hereby declare that all the information provided above is correct to the best of my knowledge. I understand that any false information may lead to the rejection of my application.</p>
                            
                            <div style="display:flex; justify-content:space-between; margin-top:50px;">
                                <div style="visibility: hidden;border-top: 1px solid #000; width: 200px; text-align: center; padding-top: 5px;">Date of Printing</div>
                                <div style="border-top: 1px solid #000; width: 200px; text-align: center; padding-top: 5px;">Candidate's Signature</div>
                            </div>
                            
                            <p style="text-align: center; margin-top: 30px; font-size: 10px; color: #999;">
                                System Generated Document - Printed on <span class="local-time-print">@DateTime.UtcNow.ToString("o")</span>
                            </p>
                        </div>
                    </div>
                </div>
            }
        </div>
    }
    else if (Model.Searched)
    {
        <div class="bg-white rounded-3xl border border-slate-200 p-16 text-center shadow-sm">
            <i data-lucide="alert-circle" class="w-12 h-12 text-slate-300 mx-auto mb-4"></i>
            <h3 class="text-xl font-bold text-slate-900">No Record Found</h3>
            <p class="text-slate-500 mt-2">We couldn't find any application matching the details you entered.</p>
            <a href="@Url.Action("Track")" class="mt-6 inline-block text-blue-600 font-bold hover:underline">Try searching again</a>
        </div>
    }
</div>

@section Scripts {
    <script>
        // Universal function to convert UTC to readable local time
        function toLocal(isoString, timeOnly = false) {
            if (!isoString || isoString.includes("0001-01-01")) return "—";
            const date = new Date(isoString);
            if (isNaN(date.getTime())) return isoString;

            const options = { 
                day: '2-digit', 
                month: 'short', 
                year: 'numeric',
                hour: '2-digit', 
                minute: '2-digit',
                hour12: true 
            };
            return new Intl.DateTimeFormat('en-GB', options).format(date);
        }

        document.addEventListener("DOMContentLoaded", function() {
            // Update web view times
            document.querySelectorAll('.local-time').forEach(el => {
                el.innerText = toLocal(el.getAttribute('data-utc'));
            });

            if (typeof lucide !== 'undefined') lucide.createIcons();
        });

        function printApplication(id) {
            const printElement = document.getElementById('print-source-' + id);
            
            // Update all dates inside the print section to local time before printing
            printElement.querySelectorAll('.local-time-print').forEach(el => {
                el.innerText = toLocal(el.innerText.trim());
            });

            const content = printElement.innerHTML;
            const originalBody = document.body.innerHTML;

            document.body.innerHTML = content;
            window.print();

            // Refresh to restore the page
            window.location.reload();
        }
    </script>
}