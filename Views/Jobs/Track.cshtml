@model Career635.Features.Jobs.Models.TrackViewModel
@{
    ViewData["Title"] = "Track Application | Career 635";
    
    // Helper for secure image/file access
    string GetUrl(string? path) => string.IsNullOrEmpty(path) 
        ? "" 
        : Url.Action("GetFile", "Jobs", new { path = path }) ?? "";
}

@section Styles {
    <style>
        /* --- PROFESSIONAL UI STYLES --- */
        .status-pill { padding: 0.4rem 0.8rem; border-radius: 6px; font-size: 0.7rem; font-weight: 800; text-transform: uppercase; letter-spacing: 0.025em; border: 1px solid transparent; }
        .status-pending { background: #fffbeb; color: #92400e; border-color: #fef3c7; }
        .status-shortlisted { background: #f0fdf4; color: #166534; border-color: #dcfce7; }
        .status-rejected { background: #fef2f2; color: #991b1b; border-color: #fee2e2; }

        .app-card { border: 1px solid #e2e8f0; transition: all 0.3s ease; }
        .app-card:hover { border-color: #94a3b8; box-shadow: 0 10px 15px -3px rgba(0, 0, 0, 0.1); }
        
        .meta-label { font-size: 0.65rem; color: #94a3b8; font-weight: 700; text-transform: uppercase; }
        .meta-value { font-size: 0.85rem; color: #334155; font-weight: 600; }

        /* --- PRINT SYSTEM --- */
        @@media print {
            body { background: white !important; margin: 0; padding: 0; font-family: 'Times New Roman', Times, serif; color: black; }
            .no-print { display: none !important; }
            
            .print-container { 
                display: block !important; 
                padding: 5mm;
                width: 100%;
                line-height: 1.2;
            }

            .print-header { 
                border-bottom: 2px solid #000; 
                padding-bottom: 10px; 
                margin-bottom: 25px; 
                display: flex; 
                justify-content: space-between; 
                align-items: center; 
            }

            .print-logo { height: 50px; }
            .print-title { font-size: 26pt; font-weight: bold; } /* Two-letter word "CV" used here */

            .section-title { 
                background: #f1f5f9 !important; 
                padding: 2px 12px; 
                font-weight: bold; 
                border: 1px solid #000; 
                margin-top: 20px; 
                text-transform: uppercase;
                font-size: 11pt;
                -webkit-print-color-adjust: exact;
            }

            table { width: 100%; border-collapse: collapse; margin-top: 10px; }
            th, td { border: 1px solid #000; padding: 10px; text-align: left; font-size: 10pt; vertical-align: top; }
            
            .photo-box { 
                width: 35mm; 
                height: 45mm; 
                border: 1px solid #000; 
                display: flex; 
                align-items: center; 
                justify-content: center; 
                text-align: center;
                font-size: 9pt;
            }

            .declaration-box { margin-top: 40px; font-size: 11pt; border-top: 1px solid #eee; padding-top: 20px; }
        }
    </style>
}

@functions {
    public string Val(object? val) {
        if (val == null) return "—";
        string s = val.ToString()?.Trim() ?? "";
        if (string.IsNullOrEmpty(s) || s == "0" || s == "0.00" || s.Contains("0001-01-01")) return "—";
        return s;
    }
}

<div class="container mx-auto px-6 py-12 max-w-5xl no-print">
    
    <!-- HEADER -->
    <div class="text-center mb-12">
        <img src="/career635.png" alt="Career 635" class="h-16 mx-auto mb-6" />
        <h1 class="text-4xl font-black text-slate-900 tracking-tight">Application Tracker</h1>
        <p class="text-slate-500 font-medium">Verify your recruitment status and retrieve your submission records.</p>
    </div>

    <!-- SEARCH -->
    <div class="max-w-2xl mx-auto mb-16">
        <form method="get" class="bg-white p-2 rounded-2xl shadow-2xl border border-slate-100 flex flex-col md:flex-row gap-2">
            <div class="flex-1 flex items-center px-4 gap-3 py-2">
                <i data-lucide="search" class="w-5 h-5 text-slate-400"></i>
                <input name="code" value="@Model.SearchValue" type="text" 
                       placeholder="Tracking ID (e.g. C635-XYZ) or CNIC Number (e.g. XXXXX-XXXXXXX-X)" 
                       class="w-full bg-transparent outline-none font-bold text-slate-700" required />
            </div>
            <button type="submit" class="bg-slate-900 text-white px-10 py-4 rounded-xl font-bold hover:bg-indigo-600 transition-all flex items-center justify-center gap-2">
                Search
            </button>
        </form>
    </div>

    @if (Model.Searched && Model.Result != null)
    {
        <div class="space-y-6">
            @foreach (var app in Model.Result.Applications)
            {
                <div class="bg-white rounded-2xl app-card overflow-hidden">
                    <div class="p-8">
                        <div class="flex flex-col lg:flex-row lg:items-center justify-between gap-8">
                            
                            <div class="flex-1">
                                <div class="flex items-center gap-4 mb-4">
                                    <span class="text-xs font-bold text-slate-400 font-mono">REF: @app.TrackingCode</span>
                                    <span class="status-pill status-@app.Status.ToLower()">@app.Status</span>
                                  @if(!string.IsNullOrWhiteSpace(app.Remarks)) { <span class="text-xs font-bold text-slate-400 font-mono">Remarks: @app.Remarks</span>
}
                                </div>
                                
                                <h2 class="text-2xl font-black text-slate-900 mb-6">@app.JobTitle</h2>
                                
                                <div class="grid grid-cols-1 sm:grid-cols-3 gap-6 border-t border-slate-50 pt-6">
                                    <div>
                                        <p class="meta-label">Applied On</p>
                                        <p class="meta-value local-time" data-utc="@app.AppliedAt.ToString("o")">...</p>
                                    </div>
                                    <div>
                                        <p class="meta-label">Posted On</p>
                                        <p class="meta-value local-time" data-utc="@app.PublishedDate.ToString("o")">...</p>
                                    </div>
                                    <div>
                                        <p class="meta-label">Closing Date</p>
                                        <p class="meta-value local-time" data-utc="@app.ExpiredDate.ToString("o")">...</p>
                                    </div>
                                </div>
                            </div>

                            <div class="lg:w-56">
                                @if (!app.IsExpired)
                                {
                                    <button onclick="printRecord('@app.ApplicationId')" class="w-full bg-slate-900 text-white px-6 py-4 rounded-xl font-bold text-sm hover:scale-[1.02] transition-all flex items-center justify-center gap-3">
                                        <i data-lucide="printer" class="w-5 h-5"></i> Print Record
                                    </button>
                                }
                                else
                                {
                                    <div class="text-center p-4 bg-slate-50 rounded-xl text-slate-400 text-xs font-black uppercase border border-slate-200">
                                        Expired
                                    </div>
                                }
                            </div>
                        </div>
                    </div>
                </div>

                <!-- PRINT TEMPLATE -->
                <div id="print-source-@app.ApplicationId" class="hidden">
                    <div class="print-container">
                        <div class="print-header">
                            <img src="/career635.png" class="print-logo" />
                            <div class="print-title">  Application  </div>
                            <div class="photo-box">
                                @if (!string.IsNullOrEmpty(app.Dossier.PhotoUrl)) {
                                    <img src="@GetUrl(app.Dossier.PhotoUrl)" style="width:100%; height:100%; object-fit:cover;" />
                                } else { <span>Affix Recent<br/>Photo</span> }
                            </div>
                        </div>

                        <div style="margin-bottom: 30px;">
                            <p style="font-size: 16pt; margin-bottom: 5px;"><strong>@app.Dossier.FullName</strong></p>
                            <p style="font-size: 12pt; color: #333;">Application for the position of: <strong>@app.JobTitle</strong></p>
                            <p style="font-size: 10pt; font-family: monospace;">Tracking ID: @app.TrackingCode</p>
                     @if (!string.IsNullOrWhiteSpace(app.Remarks)){   
                         <p style="font-size: 10pt; font-family: monospace;">status: @app.Status</p>
                         <p style="font-size: 10pt; font-family: monospace;">Remarks: @app.Remarks</p>
                         } 
                        </div>

                        <div class="section-title">Personal Details</div>
                        <table>
                            <tr>
                                <td width="25%"><strong>Full Name</strong></td><td width="25%">@Val(app.Dossier.FullName)</td>
                                <td width="25%"><strong>CNIC Number</strong></td><td width="25%">@Val(app.Dossier.CNIC)</td>
                            </tr>
                            <tr>
                                <td><strong>Father's Name</strong></td><td>@Val(app.Dossier.Personal.FatherName)</td>
                                <td><strong>Date of Birth</strong></td><td class="local-time-print">@app.Dossier.Personal.DOB.ToString("o")</td>
                            </tr>
                            <tr>
                                <td><strong>Phone Number</strong></td><td>@Val(app.Dossier.Personal.ContactNo)</td>
                                <td><strong>Email</strong></td><td>@Val(app.Dossier.Personal.Email)</td>
                            </tr>
                            <tr>
                                <td colspan="4"><strong>Address:</strong> @Val(app.Dossier.Personal.PresentAddress)</td>
                            </tr>
                        </table>

                        <div class="section-title">Timeline</div>
                        <table>
                            <tr>
                                <th>Job Posting Date</th>
                                <th>Submission Date</th>
                                <th>Closing Date</th>
                            </tr>
                            <tr>
                                <td class="local-time-print">@app.PublishedDate.ToString("o")</td>
                                <td class="local-time-print">@app.AppliedAt.ToString("o")</td>
                                <td class="local-time-print">@app.ExpiredDate.ToString("o")</td>
                            </tr>
                        </table>

                        <div class="declaration-box">
                            <p><strong>Declaration:</strong> I solemnly declare that all information provided in this application is true and complete to the best of my knowledge. I understand that any false statement may result in the rejection of my application at any stage.</p>
                            
                            <div style="display:flex; justify-content:space-between; margin-top:60px;">
                                <div style="border-top: 1px solid #000; width: 200px; text-align: center; padding-top: 8px;">Date</div>
                                <div style="border-top: 1px solid #000; width: 250px; text-align: center; padding-top: 8px;">Applicant Signature</div>
                            </div>
                            
                            <p style="text-align: center; margin-top: 40px; font-size: 8pt; color: #888;">
                                Generated via Career 635 Tracking Portal on <span class="local-time-print">@DateTime.UtcNow.ToString("o")</span>
                            </p>
                        </div>
                    </div>
                </div>
            }

            <!-- PAGINATION -->
            @if (Model.Result.TotalPages > 1)
            {
                <div class="flex justify-center items-center gap-3 mt-12 pb-8">
                    @for (int i = 1; i <= Model.Result.TotalPages; i++)
                    {
                        <a href="?code=@Model.SearchValue&pageNumber=@i" 
                           class="w-12 h-12 flex items-center justify-center rounded-xl font-bold text-sm transition-all @(i == Model.Result.CurrentPage ? "bg-slate-900 text-white shadow-xl" : "bg-white border border-slate-200 text-slate-500 hover:border-slate-900 hover:text-slate-900")">
                            @i
                        </a>
                    }
                </div>
            }
        </div>
    }
    else if (Model.Searched)
    {
        <div class="bg-white rounded-3xl border border-slate-200 p-20 text-center shadow-sm">
            <i data-lucide="file-warning" class="w-16 h-16 text-slate-200 mx-auto mb-6"></i>
            <h3 class="text-xl font-bold text-slate-900">No Applications Found</h3>
            <p class="text-slate-500 mt-2">No record exists for the provided ID or CNIC.</p>
            <a href="@Url.Action("Track")" class="mt-8 inline-block bg-slate-100 px-6 py-2 rounded-lg text-slate-600 font-bold text-sm">Clear Search</a>
        </div>
    }
</div>

@section Scripts {
    <script>
        function formatLocal(isoStr) {
            if (!isoStr || isoStr.includes("0001-01-01")) return "—";
            const date = new Date(isoStr);
            if (isNaN(date.getTime())) return isoStr;

            return new Intl.DateTimeFormat('en-GB', { 
                day: '2-digit', month: 'short', year: 'numeric',
                hour: '2-digit', minute: '2-digit', hour12: true 
            }).format(date);
        }

        document.addEventListener("DOMContentLoaded", function() {
            // Convert web timestamps
            document.querySelectorAll('.local-time').forEach(el => {
                el.innerText = formatLocal(el.getAttribute('data-utc'));
            });

            if (typeof lucide !== 'undefined') lucide.createIcons();
        });

        function printRecord(id) {
            const printDiv = document.getElementById('print-source-' + id);
            
            // Convert print timestamps
            printDiv.querySelectorAll('.local-time-print').forEach(el => {
                el.innerText = formatLocal(el.innerText.trim());
            });

            const content = printDiv.innerHTML;
            const originalBody = document.body.innerHTML;

            document.body.innerHTML = content;
            window.print();
            window.location.reload();
        }
    </script>
}