@model Career635.Areas.Admin.Models.NotificationIndexViewModel
@{
    Layout = "_AdminLayout";
    ViewData["Title"] = "System Alerts Registry";
}

<div class="space-y-10 pb-20">
    <!-- 1. HEADER SECTION -->
    <div class="flex flex-col md:flex-row justify-between items-start md:items-end gap-6">
        <div>
            <h1 class="text-3xl font-black text-slate-900 tracking-tighter uppercase leading-none">Security & System Alerts</h1>
            <p class="text-xs text-slate-400 font-bold uppercase tracking-widest mt-2">Audit trail of automated notifications and system logs</p>
        </div>
        
        <!-- MARK ALL AS READ ACTION -->
        <form asp-action="MarkAllAsRead" method="post">
            <button type="submit" class="px-6 py-3 bg-white border border-slate-200 rounded-xl text-[10px] font-black uppercase tracking-widest text-slate-500 hover:text-emerald-600 hover:border-emerald-200 transition-all shadow-sm flex items-center gap-2">
                <i data-lucide="check-check" class="w-3.5 h-3.5"></i> Mark all as read
            </button>
        </form>
    </div>

    <!-- 2. SEARCH & FILTER ARCHITECTURE -->
    <form method="get" class="bg-white p-4 rounded-[2rem] border border-slate-200 shadow-sm flex flex-wrap items-center gap-4">
        <div class="flex items-center gap-2 px-4 border-r border-slate-100">
            <i data-lucide="filter" class="w-4 h-4 text-slate-300"></i>
            <span class="text-[10px] font-black text-slate-400 uppercase tracking-widest">Filters</span>
        </div>

        <select name="type" class="bg-slate-50 border-none rounded-xl px-6 py-3 text-[10px] font-black uppercase text-slate-500 outline-none focus:ring-2 focus:ring-emerald-500/20">
            <option value="">All Categories</option>
            <option value="Info" selected="@(Model.TypeFilter == "Info")">Information</option>
            <option value="Success" selected="@(Model.TypeFilter == "Success")">Success Logs</option>
            <option value="Urgent" selected="@(Model.TypeFilter == "Urgent")">Urgent Alerts</option>
        </select>

        <select name="isRead" class="bg-slate-50 border-none rounded-xl px-6 py-3 text-[10px] font-black uppercase text-slate-500 outline-none focus:ring-2 focus:ring-emerald-500/20">
            <option value="">All Statuses</option>
            <option value="false" selected="@(Model.ReadFilter == false)">Unread Only</option>
            <option value="true" selected="@(Model.ReadFilter == true)">Archive (Read)</option>
        </select>
        
        <button type="submit" class="px-8 py-3 bg-slate-900 text-white rounded-xl text-[10px] font-black uppercase tracking-widest hover:bg-emerald-600 transition-all shadow-lg shadow-slate-900/10">
            Update View
        </button>

        @if (!string.IsNullOrEmpty(Model.TypeFilter) || Model.ReadFilter.HasValue)
        {
            <a asp-action="Notifications" class="text-[10px] font-black text-red-500 uppercase tracking-widest hover:underline ml-2">Reset</a>
        }
    </form>

    <!-- 3. NOTIFICATION DATA GRID -->
    <div class="bg-white rounded-[2.5rem] border border-slate-200 shadow-sm overflow-hidden">
        <div class="divide-y divide-slate-50">
            @if (!Model.Items.Any())
            {
                <div class="p-32 text-center">
                    <div class="w-16 h-16 bg-slate-50 rounded-full flex items-center justify-center mx-auto mb-6">
                        <i data-lucide="bell-off" class="w-8 h-8 text-slate-200"></i>
                    </div>
                    <p class="text-xs font-black text-slate-300 uppercase tracking-[0.3em]">Registry is currently empty</p>
                </div>
            }

            @foreach (var n in Model.Items)
            {
                <div class="p-8 flex items-start gap-6 hover:bg-slate-50/50 transition-all group @(n.IsRead ? "opacity-60 grayscale-[0.5]" : "relative")">
                    
                    <!-- UNREAD INDICATOR -->
                    @if (!n.IsRead)
                    {
                        <div class="absolute left-0 top-0 bottom-0 w-1 bg-emerald-500"></div>
                    }

                    <!-- ICON BOX -->
                    <div class="mt-1 shrink-0">
                        @if (n.Type == "Urgent") {
                            <div class="w-12 h-12 rounded-2xl bg-red-50 text-red-500 flex items-center justify-center border border-red-100 shadow-sm"><i data-lucide="alert-triangle" class="w-5 h-5"></i></div>
                        } else if (n.Type == "Success") {
                            <div class="w-12 h-12 rounded-2xl bg-emerald-50 text-emerald-500 flex items-center justify-center border border-emerald-100 shadow-sm"><i data-lucide="check-circle" class="w-5 h-5"></i></div>
                        } else {
                            <div class="w-12 h-12 rounded-2xl bg-blue-50 text-blue-500 flex items-center justify-center border border-blue-100 shadow-sm"><i data-lucide="info" class="w-5 h-5"></i></div>
                        }
                    </div>
                    
                    <!-- CONTENT -->
                    <div class="flex-1 space-y-1">
                        <div class="flex justify-between items-start gap-4">
                            <a asp-action="NotificationDetails" asp-route-id="@n.Id" class="text-sm font-black text-slate-900 uppercase tracking-tight group-hover:text-emerald-600 transition-colors">
                                @n.Title
                            </a>
                            <span class="text-[10px] font-bold text-slate-300 whitespace-nowrap">@n.TimeAgo</span>
                        </div>
                        
                        <p class="text-sm text-slate-500 font-medium leading-relaxed line-clamp-2 max-w-3xl">
                            @n.Message
                        </p>

                        <div class="pt-4 flex items-center gap-6">
                            <a asp-action="NotificationDetails" asp-route-id="@n.Id" class="text-[10px] font-black text-slate-400 uppercase tracking-widest hover:text-emerald-600 flex items-center gap-1.5 transition-colors">
                                <i data-lucide="eye" class="w-3.5 h-3.5"></i> Read Full Briefing
                            </a>

                            @if (!string.IsNullOrEmpty(n.ActionUrl)) {
                                <a href="@n.ActionUrl" class="text-[10px] font-black text-emerald-600 uppercase tracking-widest hover:underline flex items-center gap-1.5">
                                    <i data-lucide="external-link" class="w-3.5 h-3.5"></i> Execute Target Action
                                </a>
                            }
                        </div>
                    </div>
                </div>
            }
        </div>

        <!-- 4. PAGINATION CONTROLS -->
        <div class="px-10 py-8 bg-slate-50/50 border-t border-slate-100 flex flex-col sm:flex-row justify-between items-center gap-6">
            <div class="flex items-center gap-4">
                <span class="text-[10px] font-black text-slate-400 uppercase tracking-widest">
                    Showing <span class="text-slate-900">@Model.Items.Count()</span> of <span class="text-slate-900">@Model.TotalCount</span> Alerts
                </span>
            </div>

            <div class="flex items-center gap-3">
                @if (Model.HasPreviousPage)
                {
                    <a href="@Url.Action("Notifications", new { type = Model.TypeFilter, isRead = Model.ReadFilter, page = Model.PageNumber - 1 })" 
                       class="pag-btn">
                        <i data-lucide="chevron-left" class="w-4 h-4"></i>
                        <span class="pr-1">Prev</span>
                    </a>
                }
                else
                {
                    <div class="pag-btn disabled">
                        <i data-lucide="chevron-left" class="w-4 h-4"></i>
                        <span class="pr-1">Prev</span>
                    </div>
                }

                <div class="px-4 py-2 rounded-xl bg-white border border-slate-200 text-[10px] font-black text-slate-900 shadow-sm">
                    Page @Model.PageNumber / @Model.TotalPages
                </div>

                @if (Model.HasNextPage)
                {
                    <a href="@Url.Action("Notifications", new { type = Model.TypeFilter, isRead = Model.ReadFilter, page = Model.PageNumber + 1 })" 
                       class="pag-btn">
                        <span class="pl-1">Next</span>
                        <i data-lucide="chevron-right" class="w-4 h-4"></i>
                    </a>
                }
                else
                {
                    <div class="pag-btn disabled">
                        <span class="pl-1">Next</span>
                        <i data-lucide="chevron-right" class="w-4 h-4"></i>
                    </div>
                }
            </div>
        </div>
    </div>
</div>

<style>
    /* Pagination Button Base Styling */
    .pag-btn {
        display: inline-flex;
        align-items: center;
        gap: 0.5rem;
        padding: 0.5rem 1rem;
        background-color: white;
        border: 1px solid #e2e8f0; /* border-slate-200 */
        border-radius: 0.75rem; /* rounded-xl */
        font-size: 10px;
        font-weight: 900;
        text-transform: uppercase;
        letter-spacing: 0.1em;
        color: #64748b; /* text-slate-500 */
        transition: all 0.2s;
        box-shadow: 0 1px 2px 0 rgba(0, 0, 0, 0.05);
    }

    .pag-btn:hover {
        border-color: #10b981; /* border-emerald-500 */
        color: #10b981; /* text-emerald-500 */
        transform: translateY(-1px);
        box-shadow: 0 4px 6px -1px rgba(0, 0, 0, 0.1);
    }

    .pag-btn.disabled {
        opacity: 0.4;
        pointer-events: none;
        background-color: #f8fafc; /* bg-slate-50 */
    }
</style>

@section Scripts {
    <script>
        // Ensure icons are rendered for dynamic content
        document.addEventListener('DOMContentLoaded', function() {
            if (typeof lucide !== 'undefined') {
                lucide.createIcons();
            }
        });
    </script>
}