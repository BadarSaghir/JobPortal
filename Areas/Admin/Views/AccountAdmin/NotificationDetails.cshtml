@model Career635.Areas.Admin.Models.NotificationDto
@{
    Layout = "_AdminLayout";
    ViewData["Title"] = "Alert Briefing";
}

<div class="max-w-4xl mx-auto space-y-8">
    <!-- BACK BUTTON -->
    <a asp-action="Notifications" class="inline-flex items-center gap-2 text-[10px] font-black text-slate-400 uppercase tracking-widest hover:text-emerald-600 transition-colors">
        <i data-lucide="arrow-left" class="w-4 h-4"></i> Return to Registry
    </a>

    <!-- DETAIL CARD -->
    <div class="bg-white rounded-[2.5rem] border border-slate-200 shadow-2xl overflow-hidden animate-in fade-in zoom-in duration-500">
        <!-- HEADER STRIP -->
        <div class="px-10 py-8 border-b border-slate-50 flex justify-between items-center @(Model.Type == "Urgent" ? "bg-red-50/30" : "bg-emerald-50/30")">
            <div class="flex items-center gap-4">
                @if (Model.Type == "Urgent") {
                    <div class="w-12 h-12 rounded-2xl bg-red-500 text-white flex items-center justify-center shadow-lg shadow-red-500/20"><i data-lucide="alert-octagon" class="w-6 h-6"></i></div>
                } else if (Model.Type == "Success") {
                    <div class="w-12 h-12 rounded-2xl bg-emerald-500 text-white flex items-center justify-center shadow-lg shadow-emerald-500/20"><i data-lucide="check-shield" class="w-6 h-6"></i></div>
                } else {
                    <div class="w-12 h-12 rounded-2xl bg-blue-500 text-white flex items-center justify-center shadow-lg shadow-blue-500/20"><i data-lucide="info" class="w-6 h-6"></i></div>
                }
                <div>
                    <h1 class="text-xl font-black text-slate-900 uppercase tracking-tighter">@Model.Title</h1>
                    <p class="text-[10px] font-bold text-slate-400 uppercase tracking-widest">Logged: @Model.TimeAgo</p>
                </div>
            </div>
            <div class="px-4 py-1.5 rounded-full bg-white border border-slate-200 text-[9px] font-black uppercase tracking-widest text-slate-500">
                System Authenticated
            </div>
        </div>

        <!-- MESSAGE BODY -->
        <div class="p-10 lg:p-16">
            <div class="prose prose-slate max-w-none">
                <p class="text-lg text-slate-600 leading-relaxed font-medium">
                    @Model.Message
                </p>
            </div>

            <!-- ACTION AREA -->
            <div class="mt-16 pt-10 border-t border-slate-50 flex flex-wrap gap-4">
                @if (!string.IsNullOrEmpty(Model.ActionUrl))
                {
                    <a href="@Model.ActionUrl" class="px-8 py-4 bg-slate-900 text-white rounded-2xl text-[11px] font-black uppercase tracking-widest hover:bg-emerald-600 transition-all flex items-center gap-3 shadow-xl shadow-slate-900/10">
                        View Related Asset <i data-lucide="external-link" class="w-4 h-4"></i>
                    </a>
                }
                
                <a asp-action="Notifications" class="px-8 py-4 bg-slate-50 text-slate-500 rounded-2xl text-[11px] font-black uppercase tracking-widest hover:bg-slate-100 transition-all">
                    Dismiss to Registry
                </a>
            </div>
        </div>
        
        <!-- FOOTER STATUS -->
        <div class="px-10 py-5 bg-slate-50/50 border-t border-slate-50 flex items-center gap-3">
            <div class="w-2 h-2 rounded-full bg-emerald-500"></div>
            <span class="text-[9px] font-black text-slate-400 uppercase tracking-[0.2em]">Metadata: This alert was processed and marked as read on @DateTime.UtcNow.ToString("yyyy-MM-dd")</span>
        </div>
    </div>
</div>