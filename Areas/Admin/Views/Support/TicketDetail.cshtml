<!-- Areas/Admin/Views/Support/TicketDetail.cshtml -->
@model Career635.Areas.Admin.Models.SupportTicketViewModel
@{
    Layout = "_AdminLayout";
    ViewData["Title"] = $"Ticket #{Model.Id.ToString().Substring(0, 8)}";
}

<div class="max-w-4xl mx-auto space-y-8">
    <!-- Header with Back Button -->
    <div class="flex justify-between items-center">
        <a asp-action="List" asp-route-status="@ViewBag.CurrentStatus" class="inline-flex items-center gap-2 text-[10px] font-black text-slate-400 uppercase tracking-widest hover:text-emerald-600 transition-colors">
            <i data-lucide="arrow-left" class="w-4 h-4"></i> Back to Tickets
        </a>
        
        <form asp-action="DeleteTicket" asp-route-id="@Model.Id" method="post" 
              onsubmit="return confirm('Are you sure you want to delete this ticket?');" class="inline">
            @Html.AntiForgeryToken()
            <button type="submit" class="px-4 py-2 bg-red-50 text-red-600 rounded-xl text-[10px] font-black uppercase tracking-widest hover:bg-red-100 transition-all">
                Delete Ticket
            </button>
        </form>
    </div>

    <!-- Main Ticket Card -->
    <div class="bg-white rounded-[2.5rem] border border-slate-200 shadow-2xl overflow-hidden">
        <!-- Header Strip with Status -->
        <div class="px-10 py-8 border-b border-slate-100 bg-gradient-to-r from-slate-50 to-white">
            <div class="flex items-start justify-between">
                <div class="space-y-2">
                    <div class="flex items-center gap-3">
                        <div class="w-12 h-12 rounded-2xl bg-red-100 text-red-600 flex items-center justify-center">
                            <i data-lucide="ticket" class="w-6 h-6"></i>
                        </div>
                        <div>
                            <h1 class="text-2xl font-black text-slate-900 uppercase tracking-tighter">
                                Support Ticket #@Model.Id.ToString().Substring(0, 8)
                            </h1>
                            <div class="flex items-center gap-3 mt-1">
                                <p class="text-[10px] font-bold text-slate-400 uppercase tracking-widest">
                                    Created @Model.TimeAgo • @Model.CreatedAt.ToString("MMMM dd, yyyy HH:mm")
                                </p>
                                <span class="px-2 py-0.5 rounded-full text-[9px] font-black uppercase tracking-wider @Model.StatusBadgeClass border">
                                    @Model.Status
                                </span>
                            </div>
                        </div>
                    </div>
                </div>
            </div>
        </div>

        <!-- Content -->
        <div class="p-10 space-y-8">
            <!-- Requester Information -->
            <div class="grid md:grid-cols-2 gap-6 pb-6 border-b border-slate-100">
                <div>
                    <label class="block text-[9px] font-black text-slate-400 uppercase tracking-widest mb-2">From</label>
                    <div class="flex items-center gap-2">
                        <i data-lucide="mail" class="w-4 h-4 text-slate-400"></i>
                        <span class="text-sm font-medium text-slate-700">@Model.Email</span>
                    </div>
                </div>
                <div>
                    <label class="block text-[9px] font-black text-slate-400 uppercase tracking-widest mb-2">Technical Metadata</label>
                    <div class="space-y-1">
                        <div class="flex items-center gap-2 text-xs text-slate-500">
                            <i data-lucide="map-pin" class="w-3 h-3"></i>
                            <span>IP: @(Model.IPAddress ?? "Not recorded")</span>
                        </div>
                        <div class="flex items-center gap-2 text-xs text-slate-500">
                            <i data-lucide="computer" class="w-3 h-3"></i>
                            <span class="truncate">User Agent: @(Model.UserAgent ?? "Not recorded")</span>
                        </div>
                    </div>
                </div>
            </div>

            <!-- User's Message -->
            <div class="space-y-3">
                <label class="block text-[9px] font-black text-slate-400 uppercase tracking-widest">User's Message</label>
                <div class="bg-slate-50 rounded-2xl p-6 border border-slate-100">
                    <p class="text-slate-700 leading-relaxed whitespace-pre-wrap">@Model.Message</p>
                </div>
            </div>

            <div class="pt-6 border-t border-slate-100">
                <h3 class="text-sm font-black text-slate-700 uppercase tracking-wider mb-6 flex items-center gap-2">
                    <i data-lucide="edit-3" class="w-4 h-4"></i>
                    Update Ticket
                </h3>
                
                <form asp-action="UpdateTicket" asp-route-id="@Model.Id" method="post" class="space-y-6">
                    @Html.AntiForgeryToken()
                    
             
                    
                    <!-- Status Selection -->
                    <div>
                        <label class="block text-[10px] font-black text-slate-500 uppercase tracking-widest mb-2">Ticket Status</label>
                        <div class="grid grid-cols-2 md:grid-cols-4 gap-3">
                            <label class="flex items-center gap-2 p-3 border rounded-xl cursor-pointer hover:bg-slate-50 transition-all @(Model.Status == "Open" ? "border-red-500 bg-red-50" : "border-slate-200")">
                                <input type="radio" name="status" value="Open" @(Model.Status == "Open" ? "checked" : "") class="text-red-600">
                                <span class="text-xs font-bold text-red-700">Open</span>
                            </label>
                            
                            <label class="flex items-center gap-2 p-3 border rounded-xl cursor-pointer hover:bg-slate-50 transition-all @(Model.Status == "InProgress" ? "border-yellow-500 bg-yellow-50" : "border-slate-200")">
                                <input type="radio" name="status" value="InProgress" @(Model.Status == "InProgress" ? "checked" : "") class="text-yellow-600">
                                <span class="text-xs font-bold text-yellow-700">In Progress</span>
                            </label>
                            
                            <label class="flex items-center gap-2 p-3 border rounded-xl cursor-pointer hover:bg-slate-50 transition-all @(Model.Status == "Resolved" ? "border-green-500 bg-green-50" : "border-slate-200")">
                                <input type="radio" name="status" value="Resolved" @(Model.Status == "Resolved" ? "checked" : "") class="text-green-600">
                                <span class="text-xs font-bold text-green-700">Resolved</span>
                            </label>
                            
                            <label class="flex items-center gap-2 p-3 border rounded-xl cursor-pointer hover:bg-slate-50 transition-all @(Model.Status == "Closed" ? "border-gray-500 bg-gray-50" : "border-slate-200")">
                                <input type="radio" name="status" value="Closed" @(Model.Status == "Closed" ? "checked" : "") class="text-gray-600">
                                <span class="text-xs font-bold text-gray-700">Closed</span>
                            </label>
                        </div>
                    </div>
                    
                    <!-- Submit Button -->
                    <div class="flex justify-end pt-4">
                        <button type="submit" class="px-8 py-3 @Model.StatusButtonClass text-white rounded-xl text-[11px] font-black uppercase tracking-widest hover:scale-105 transition-all shadow-lg">
                            Update Ticket
                        </button>
                    </div>
                </form>
            </div>
        </div>
    </div>
</div>

@section Scripts {
    <script>
        document.addEventListener('DOMContentLoaded', function() {
            if (typeof lucide !== 'undefined') {
                lucide.createIcons();
            }
        });
    </script>
}