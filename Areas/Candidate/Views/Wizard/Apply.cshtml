                        <select asp-for="FamilyIncomeDetail" class="form-input">
                            <option value="">-- Monthly Family Income --</option>
                            <option value="Less than 50k PKR">Less than 50k PKR</option>
                            <option value="Between 50k and 1 Lac PKR">Between 50k and 1 Lac PKR</option>
                            <option value="Between 1Lac and 1.5 Lac PKR">Between 1Lac and 1.5 Lac PKR</option>
                            <option value="Between 2Lac and 3 Lac PKR">Between 2Lac and 3 Lac PKR</option>
