                        <input asp-for="ArmyPayScale" class="form-input" placeholder="Pay Scale" maxlength="50" />
                    </div>
                </div>
                <div class="bg-slate-50 p-6 rounded-3xl border border-slate-100">
                    <h4 class="font-bold mb-4 text-slate-700">Financials</h4>
                    <div class="grid grid-cols-1 gap-4">
                        <input asp-for="CurrentSalary" type="number" min="0" class="form-input" placeholder="Current Salary (PKR)" />
