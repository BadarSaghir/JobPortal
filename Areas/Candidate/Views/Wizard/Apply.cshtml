                    </div>
                </div>
            </div>

            <!-- MANDATORY FILES UPLOAD SECTION -->
            <div class="grid grid-cols-1 md:grid-cols-2 gap-8 mb-10 p-6 bg-emerald-50/30 rounded-3xl border border-emerald-100 relative">
                <div class="space-y-2">
                    <label class="section-label text-emerald-800">Passport Photo <span class="text-red-500">*</span></label>
                    <p class="text-[9px] text-emerald-700 font-bold mb-2">Max 200KB. Allowed: JPG, PNG, WEBP</p>
                    <input type="file" id="PassportPhotoInput" name="PassportPhoto" required class="required-check filepond-input" />
                </div>
                <div class="space-y-2">
                    <label class="section-label text-emerald-800">Updated CV / Resume <span class="text-red-500">*</span></label>
                    <p class="text-[9px] text-emerald-700 font-bold mb-2">Max 500KB. Allowed: PDF, JPG, PNG, WEBP</p>
                    <input type="file" id="CvFileInput" name="CvFile" required class="required-check filepond-input" />
                </div>
            </div>

            <div>
                <div class="flex justify-between items-center mb-4">
                    <div>
                        <h4 class="font-bold text-slate-700">Supporting Documents (Degrees/Certs)</h4>
                        <p class="text-[10px] text-slate-500 uppercase font-bold">Max 150KB per file. Formats: PDF, JPG, PNG</p>
                    </div>
                    <button type="button" onclick="addDynamicRow('doc-container', 'doc-template', 'DocumentAttachments')" class="text-[10px] font-black bg-emerald-50 text-emerald-600 px-4 py-2 rounded-lg hover:bg-emerald-100">+ ADD DOCUMENT</button>
                </div>
                <div id="doc-container" class="space-y-4">
                    @for (int i = 0; i < Model.DocumentAttachments.Count; i++) {
                        <div class="repeater-card border-l-emerald-500 bg-emerald-50/10" data-index="@i">
                            <button type="button" onclick="removeRow(this, 'doc-container', 'DocumentAttachments')" class="absolute top-3 right-3 text-red-400 hover:text-red-600 font-bold text-xs">REMOVE</button>
                            <div class="grid grid-cols-1 md:grid-cols-1 gap-6 mt-4">
                                <div>
                                    <label class="section-label">Document Category <span class="text-red-500">*</span></label>
                                    <select name="DocumentAttachments[@i].DocumentType" class="form-input required-check" required>
                                        <option value="">-- Select Type --</option>
                                        <option value="Education" selected="@(Model.DocumentAttachments[i].DocumentType == "Education")">Education (Degrees/Transcripts)</option>
                                        <option value="Experience" selected="@(Model.DocumentAttachments[i].DocumentType == "Experience")">Experience Letters</option>
                                        <option value="Degree" selected="@(Model.DocumentAttachments[i].DocumentType == "Degree")">Professional Degree</option>
                                        <option value="Certificates" selected="@(Model.DocumentAttachments[i].DocumentType == "Certificates")">Certifications</option>
                                    </select>
                                </div>
                                <div>
                                    <label class="section-label">Select Files (Max 150KB/file) <span class="text-red-500">*</span></label>
                                    <input type="file" name="DocumentAttachments[@i].Files" class="form-input bg-white doc-file-input required-check" multiple required accept=".pdf,.jpg,.jpeg,.png" onchange="validateDocumentFiles(this)" />
                                    <div class="file-info-text text-[10px] mt-1 text-slate-500 font-bold">Waiting for selection...</div>
                                </div>
                            </div>
                        </div>
                    }
                </div>
            </div>
        </div>

        <!-- SUBMIT BUTTON AREA -->
        <div class="flex flex-col items-end pt-4">
            <button type="submit" id="btnFinalSubmit" class="w-full md:w-auto bg-blue-600 text-white font-black text-lg py-5 px-16 rounded-2xl shadow-xl hover:bg-blue-700 hover:shadow-2xl hover:-translate-y-1 transition-all flex items-center justify-center gap-3">
                Submit Application <i data-lucide="check-circle" class="w-6 h-6"></i>
            </button>
        </div>
    </form>
</div>

