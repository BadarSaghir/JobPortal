@section Scripts {
    <partial name="_ValidationScriptsPartial" />

    <script>
        let pondPhoto = null;
        let pondCV = null;

        function reindexContainer(containerId, baseName) {
            const container = document.getElementById(containerId);
            if (!container) return;
            const rows = container.children;
            for (let i = 0; i < rows.length; i++) {
                const row = rows[i];
                row.querySelectorAll('input, select, textarea').forEach(el => {
                    const name = el.getAttribute('name');
                    if (name && name.startsWith(baseName + '[')) {
                        const newName = name.replace(/\[.*?\]/, `[${i}]`);
                        el.setAttribute('name', newName);
                    }
                });
                row.setAttribute('data-index', i);
            }
        }

        function addDynamicRow(containerId, templateId, baseName) {
            const container = document.getElementById(containerId);
            const template = document.getElementById(templateId).innerHTML;
            const currentCount = container.children.length;
            const newRowHtml = template.replace(/{idx}/g, currentCount);
            container.insertAdjacentHTML('beforeend', newRowHtml);
            if (typeof flatpickr !== 'undefined') flatpickr(".datepicker", { dateFormat: "Y-m-d", maxDate: "today" });
            if (typeof lucide !== 'undefined') lucide.createIcons();

            // Re-attach validation events
            $(container).find('.required-check, .cnic-mask, .digits-only, .email-check, .edu-qualification-req, .edu-major-req, .edu-board-req, .edu-cgpa-req, .edu-from-req, .edu-to-req, .exp-org-req, .exp-designation-req, .exp-from-req, .sibling-name-req, .sibling-dob-req, .skill-name-req, .skill-proficiency-req, .cert-name-req, .cert-issuer-req, .rel-name-req, .ach-title-req, .ach-date-req').off('blur change input').on('blur change input', function() { validateFieldRealTime(this); });
        }

        function removeRow(btn, containerId, baseName) {
            const row = btn.closest('.repeater-card') || btn.parentElement;
            if (row) {
                row.remove();
                reindexContainer(containerId, baseName);
            }
        }

        function validateDocumentFiles(input) {
            const maxSize = 150 * 1024;
            const allowedExtensions = ['pdf', 'jpg', 'jpeg', 'png'];
            const files = input.files;
            let errorMsg = "";

            for (let i = 0; i < files.length; i++) {
                const ext = files[i].name.split('.').pop().toLowerCase();
                if (!allowedExtensions.includes(ext)) {
                    errorMsg = `File "${files[i].name}" has an invalid format. Only PDF, JPG, and PNG are allowed.`;
                    break;
                }
                if (files[i].size > maxSize) {
                    errorMsg = `File "${files[i].name}" is too large (${(files[i].size / 1024).toFixed(1)}KB). Max allowed is 150KB.`;
                    break;
                }
            }

            const label = input.parentElement.querySelector('.file-info-text');
            if (errorMsg) {
                alert(errorMsg);
                input.value = "";
                $(input).addClass('input-validation-error');
                label.innerText = "Error: Invalid file removed.";
                label.classList.replace('text-emerald-600', 'text-red-500');
            } else if (files.length > 0) {
                $(input).removeClass('input-validation-error');
                label.innerText = `${files.length} file(s) selected - Validated ✓`;
                label.classList.remove('text-red-500', 'text-slate-500');
                label.classList.add('text-emerald-600');
            }
            validateFieldRealTime(input);
        }

        // Core validation: required / CNIC / mobile / email / conditional required for dynamic rows
        function validateFieldRealTime(el) {
            const $el = $(el);
            if ($el.hasClass('filepond--browser') || $el.closest('.filepond--root').length) return true;

            let isValid = true;
            let val = $el.val() ? $el.val().trim() : "";

            // 1. Standard required attribute
            if ($el.is('[required]') && val === "") isValid = false;

            // 2. Conditional validations for dynamic rows
            const row = $el.closest('.repeater-card');
            if (row.length) {
                // Helper to validate a field inside the same row
        const validateFieldInRow = (selector, errorCondition) => {
    const field = row.find(selector);
    if (field.length && errorCondition(field)) {
        field.addClass('input-validation-error');
        // Only mark the current field invalid if it's the one being validated
        if (field[0] === el) {
            isValid = false;
        }
    } else if (field.length) {
        field.removeClass('input-validation-error');
    }
};

                // --- Education Row ---
                const eduQual = row.find('.edu-qualification-req');
                if (eduQual.length && eduQual.val() && eduQual.val().trim() !== "") {
                    validateFieldInRow('.edu-major-req', f => !f.val() || f.val().trim() === "");
                    validateFieldInRow('.edu-board-req', f => !f.val() || f.val().trim() === "");
                    validateFieldInRow('.edu-cgpa-req', f => !f.val() || f.val().trim() === "");
                    validateFieldInRow('.edu-from-req', f => !f.val() || f.val().trim() === "");
                    validateFieldInRow('.edu-to-req', f => !f.val() || f.val().trim() === "");
                } else {
                    row.find('.edu-major-req, .edu-board-req, .edu-cgpa-req, .edu-from-req, .edu-to-req').removeClass('input-validation-error');
                }

                // --- Experience Row ---
                const expOrg = row.find('.exp-org-req');
                if (expOrg.length && expOrg.val() && expOrg.val().trim() !== "") {
                    validateFieldInRow('.exp-designation-req', f => !f.val() || f.val().trim() === "");
                    validateFieldInRow('.exp-from-req', f => !f.val() || f.val().trim() === "");
                } else {
                    row.find('.exp-designation-req, .exp-from-req').removeClass('input-validation-error');
                }

                // --- Sibling Row ---
                const sibName = row.find('.sibling-name-req');
                if (sibName.length && sibName.val() && sibName.val().trim() !== "") {
                    validateFieldInRow('.sibling-dob-req', f => !f.val() || f.val().trim() === "");
                } else {
                    row.find('.sibling-dob-req').removeClass('input-validation-error');
                }

                // --- Skill Row ---
                const skillName = row.find('.skill-name-req');
                if (skillName.length && skillName.val() && skillName.val().trim() !== "") {
                    validateFieldInRow('.skill-proficiency-req', f => !f.val() || f.val().trim() === "");
                } else {
                    row.find('.skill-proficiency-req').removeClass('input-validation-error');
                }

                // --- Certification Row ---
                const certName = row.find('.cert-name-req');
                if (certName.length && certName.val() && certName.val().trim() !== "") {
                    validateFieldInRow('.cert-issuer-req', f => !f.val() || f.val().trim() === "");
                } else {
                    row.find('.cert-issuer-req').removeClass('input-validation-error');
                }

                // --- Internal Relative Row --- (no extra fields required besides name)
                // --- Achievement Row ---
                const achTitle = row.find('.ach-title-req');
                if (achTitle.length && achTitle.val() && achTitle.val().trim() !== "") {
                    validateFieldInRow('.ach-date-req', f => !f.val() || f.val().trim() === "");
                } else {
                    row.find('.ach-date-req').removeClass('input-validation-error');
                }
            }

            // 3. CNIC format
            if (isValid && $el.hasClass('cnic-mask') && val !== "") {
                const cnicRegex = /^\d{5}-\d{7}-\d{1}$/;
                if (!cnicRegex.test(val)) isValid = false;
            }

            // 4. Digits only (mobile)
            if (isValid && $el.hasClass('digits-only') && val !== "") {
                const digitsRegex = /^\d+$/;
                if (!digitsRegex.test(val)) isValid = false;
            }

            // 5. Email format
            if (isValid && $el.hasClass('email-check') && val !== "") {
                const emailRegex = /^[^\s@@]+@@[^\s@@]+\.[^\s@@]+$/;
                if (!emailRegex.test(val)) isValid = false;
            }

            // 6. File inputs that are required
            if (isValid && $el.is('input[type="file"]') && $el.is('[required]')) {
                if (!el.files || el.files.length === 0) isValid = false;
            }

            $el.toggleClass('input-validation-error', !isValid);
            return isValid;
        }

        // ========== NEW: Fill empty fields in dynamic rows with "N/A" ==========
        function setEmptyDynamicFieldsToNA() {
            // Dynamic row containers and also simple list containers for skills/certs
            const containers = [
                '#sib-container', '#edu-container', '#exp-container', 
                '#skill-container', '#cert-container', '#rel-container', 
                '#ach-container', '#doc-container'

            ];
            
            containers.forEach(containerSelector => {
                const container = $(containerSelector);
                if (!container.length) return;
                
                // Handle both .repeater-card and flex rows (skills/certs)
                container.find('.repeater-card, .flex.gap-2.items-center').each(function() {
                    // Find all text inputs, textareas, number inputs (but skip file inputs and datepickers)
                    $(this).find('input[type="text"], input[type="number"], textarea, input[type="tel"], input[type="email"]').each(function() {
                        const $field = $(this);
                        // Skip datepicker fields (to avoid breaking date parsing on server)
                        if ($field.hasClass('datepicker')) return;
                        // Skip hidden or disabled fields
                        if ($field.prop('type') === 'hidden' || $field.prop('disabled')) return;
                        
                        let val = $field.val();
                        if (val === undefined || val === null || val.trim() === '') {
                            $field.val('N/A');
                        }
                    });
                });
            });
            
            // Additionally handle standalone skill/cert rows that might not be in repeater-card
            $('#skill-container .flex, #cert-container .flex').each(function() {
                $(this).find('input[type="text"]').each(function() {
                    const $field = $(this);
                    if ($field.hasClass('datepicker')) return;
                    let val = $field.val();
                    if (val === undefined || val === null || val.trim() === '') {
                        $field.val('N/A');
                    }
                });
            });
        }

        $(document).ready(function() {
            // Auto‑format CNIC
            $(document).on('input', '.cnic-mask', function() {
                let value = $(this).val().replace(/\D/g, '');
                if (value.length > 13) value = value.substring(0, 13);
                let formatted = '';
                if (value.length > 5) {
                    formatted += value.substring(0, 5) + '-';
                    if (value.length > 12) formatted += value.substring(5, 12) + '-' + value.substring(12, 13);
                    else formatted += value.substring(5);
                } else {
                    formatted = value;
                }
                $(this).val(formatted);
            });

            $(document).on('input', '.digits-only', function() {
                let value = $(this).val().replace(/\D/g, '');
                if (value.length > 20) value = value.substring(0, 20);
                $(this).val(value);
            });

            // Attach real‑time validation to all required‑like elements
            $(document).on('blur change input', 'input[required], select[required], textarea[required], .required-check, .cnic-mask, .digits-only, .email-check, .edu-qualification-req, .edu-major-req, .edu-board-req, .edu-cgpa-req, .edu-from-req, .edu-to-req, .exp-org-req, .exp-designation-req, .exp-from-req, .sibling-name-req, .sibling-dob-req, .skill-name-req, .skill-proficiency-req, .cert-name-req, .cert-issuer-req, .rel-name-req, .ach-title-req, .ach-date-req', function() {
                validateFieldRealTime(this);
            });

            // Specifically ensure that when cert-name changes, it triggers validation of the issuer
            $(document).on('input change blur', '.cert-name-req', function() {
                const row = $(this).closest('.repeater-card');
                if (row.length) {
                    const issuer = row.find('.cert-issuer-req');
                    if (issuer.length) validateFieldRealTime(issuer[0]);
                }
            });

            // Reindex existing collections on page load
            const containers = ['sib', 'edu', 'exp', 'skill', 'cert', 'rel', 'ach', 'doc'];
            const baseNames = ['Siblings', 'Educations', 'Experiences', 'Skills', 'Certifications', 'InternalRelatives', 'Achievements', 'DocumentAttachments'];
            containers.forEach((prefix, i) => reindexContainer(`${prefix}-container`, baseNames[i]));

            // Ensure at least one document attachment row exists
            if ($('#doc-container').children().length === 0) {
                addDynamicRow('doc-container', 'doc-template', 'DocumentAttachments');
            }

            if (typeof flatpickr !== 'undefined') {
                flatpickr(".datepicker", {
                    dateFormat: "Y-m-d",
                    maxDate: "today",
                    onChange: function(selectedDates, dateStr, instance) {
                        validateFieldRealTime(instance.element);
                    }
                });
            }

            // FilePond configuration for main uploads
            if (typeof FilePond !== 'undefined') {
                FilePond.registerPlugin(FilePondPluginFileValidateSize, FilePondPluginFileValidateType);
                pondPhoto = FilePond.create(document.querySelector('#PassportPhotoInput'), {
                    storeAsFile: true,
                    maxFileSize: '200KB',
                    acceptedFileTypes: ['image/jpeg', 'image/png', 'image/webp'],
                    labelIdle: 'Drag & Drop Photo or <span class="filepond--label-action">Browse</span>',
                    onaddfile: (error, file) => {
                        if (!error) $('#PassportPhotoInput').closest('.filepond--root').parent().removeClass('file-error-highlight');
                    },
                    onremovefile: () => {
                        if (pondPhoto.getFiles().length === 0) $('#PassportPhotoInput').closest('.filepond--root').parent().addClass('file-error-highlight');
                    }
                });
                pondCV = FilePond.create(document.querySelector('#CvFileInput'), {
                    storeAsFile: true,
                    maxFileSize: '500KB',
                    acceptedFileTypes: ['application/pdf', 'image/jpeg', 'image/png', 'image/webp'],
                    labelIdle: 'Drag & Drop CV or <span class="filepond--label-action">Browse</span>',
                    onaddfile: (error, file) => {
                        if (!error) $('#CvFileInput').closest('.filepond--root').parent().removeClass('file-error-highlight');
                    },
                    onremovefile: () => {
                        if (pondCV.getFiles().length === 0) $('#CvFileInput').closest('.filepond--root').parent().addClass('file-error-highlight');
                    }
                });
            }

            if (typeof lucide !== 'undefined') lucide.createIcons();

            // ************** FORM SUBMIT HANDLER **************
            $('#applicationForm').on('submit', function(e) {
                e.preventDefault();
                let isValid = true;
                let errorMessages = new Set();
                $('#formErrorBox').addClass('hidden');
                $('#formErrorMsg').html('');

                // 1. Remove completely empty dynamic rows (no data at all)
                $('.repeater-card').each(function() {
                    let hasData = false;
                    $(this).find('input[type="text"], input[type="date"], input[type="number"], select:not([name$="Gender"]):not([name$="MaritalStatus"]), textarea').each(function() {
                        if ($(this).val() && $(this).val().trim() !== '' && $(this).val() !== '0') hasData = true;
                    });
                    if ($(this).find('input[type="file"]').length > 0) {
                        let fileInput = $(this).find('input[type="file"]')[0];
                        if (fileInput.files && fileInput.files.length > 0) hasData = true;
                    }
                    if (!hasData) $(this).remove();
                });

                // Reindex after cleanup
                containers.forEach((prefix, i) => reindexContainer(`${prefix}-container`, baseNames[i]));

                // 2. Validate all fields (the real-time validation already marks errors, but we need to collect messages)
                const allInputs = $(this).find('input[required], select[required], textarea[required], .required-check, .cnic-mask, .digits-only, .email-check, .edu-qualification-req, .edu-major-req, .edu-board-req, .edu-cgpa-req, .edu-from-req, .edu-to-req, .exp-org-req, .exp-designation-req, .exp-from-req, .sibling-name-req, .sibling-dob-req, .skill-name-req, .skill-proficiency-req, .cert-name-req, .cert-issuer-req, .rel-name-req, .ach-title-req, .ach-date-req');
                allInputs.each(function() {
                    if (!validateFieldRealTime(this)) {
                        isValid = false;
                        let label = $(this).closest('div, label').find('label').first().text() || $(this).attr('placeholder') || $(this).attr('name');
                        if (label) errorMessages.add(`• ${label} is required or has an invalid format.`);
                        else errorMessages.add(`• A required field is missing (${$(this).attr('name')})`);
                    }
                });

                // 3. Explicit FilePond checks for main uploads
                if (pondPhoto && pondPhoto.getFiles().length === 0) {
                    $('#PassportPhotoInput').closest('.filepond--root').parent().addClass('file-error-highlight');
                    isValid = false;
                    errorMessages.add("• Passport Photo is required.");
                }
                if (pondCV && pondCV.getFiles().length === 0) {
                    $('#CvFileInput').closest('.filepond--root').parent().addClass('file-error-highlight');
                    isValid = false;
                    errorMessages.add("• CV / Resume is required.");
                }

                if (!isValid) {
                    let finalErrorHtml = '<ul class="list-disc ml-5">';
                    if (errorMessages.size === 0) errorMessages.add("Please fill out all mandatory fields highlighted in red.");
                    errorMessages.forEach(msg => finalErrorHtml += `<li>${msg}</li>`);
                    finalErrorHtml += '</ul>';
                    $('#formErrorMsg').html(finalErrorHtml);
                    $('#formErrorBox').removeClass('hidden');

                    let firstError = $('.input-validation-error, .file-error-highlight').first();
                    if (firstError.length) {
                        $('html, body').animate({ scrollTop: firstError.offset().top - 150 }, 500);
                    }
                    return false;
                }

                // ========== CRITICAL: Fill any empty dynamic row fields with "N/A" ==========
                setEmptyDynamicFieldsToNA();

                // If validation passes, show loading and submit natively
                $('#btnFinalSubmit').html('Processing Application... <i class="fa fa-spinner fa-spin ml-2"></i>').addClass('opacity-75 pointer-events-none');
                this.submit();
            });
        });
    </script>
}